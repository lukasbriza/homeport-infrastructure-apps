{
  "name": "@lukasbriza/eslint-config",
  "version": "0.0.0",
  "description": "ESLint flat configuration for projects.",
  "sideEffects": false,
  "exports": {
    ".": "./index.mjs",
    "./base": "./base.mjs",
    "./react": "./react.mjs",
    "./react-native": "./react-native.mjs",
    "./nextjs": "./nextjs.mjs",
    "./nestjs": "./nestjs.mjs"
  },
  "files": [
    "base.mjs",
    "index.mjs",
    "nestjs.mjs",
    "nextjs.mjs",
    "react.mjs",
    "react-native.mjs"
  ],
  "scripts": {
    "cleanup": "rimraf .eslintcache .turbo node_modules",
    "fix": "run-p format:fix lint:fix",
    "format": "prettier --check \"./**/*.{json,md}\"",
    "format:fix": "pnpm run format --write",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.10",
    "@typescript-eslint/parser": "8.63.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.10.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-formatjs": "6.4.16",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "65.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "typescript-eslint": "8.63.0"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "prettier": "3.9.4",
    "react": "19.2.7"
  },
  "peerDependencies": {
    "eslint": "9.39.4",
    "react": "19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
