{
  "name": "@lukasbriza/homeport-infrastructure-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure apps for homeport home lab.",
  "author": "https://github.com/lukasbriza",
  "type": "module",
  "workspaces": [
    "./apps/*",
    "./infrastructure/*",
    "./packages/*",
    "./core/*"
  ],
  "scripts": {
    "build": "turbo build",
    "cleanup": "turbo run cleanup --no-daemon && pnpm run postcleanup",
    "postcleanup": "rimraf .eslintcache tsconfig.tsbuildinfo node_modules",
    "core-docker:build-local": "dotenv -e core/pi-hole/.env.local -- docker compose -f docker-compose-local.core.yaml --profile DNS build",
    "core-docker:run-local": "dotenv -e core/pi-hole/.env.local -- docker compose -f docker-compose-local.core.yaml --profile DNS up --build -V -d",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint --no-daemon",
    "lint:fix": "turbo run lint:fix --no-daemon",
    "prepare": "node scripts/husky-prepare.js",
    "prepare:husky": "husky",
    "test": "turbo test",
    "ts": "turbo run ts --no-daemon"
  },
  "dependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "9.6.0",
    "@lukasbriza/eslint-config": "workspace:*",
    "@lukasbriza/prettier-config": "workspace:*",
    "@lukasbriza/ts-config": "workspace:*",
    "@types/node": "20.14.9",
    "eslint": "8.57.0",
    "globals": "15.8.0",
    "husky": "9.0.11",
    "lint-staged": "15.2.7",
    "prettier": "3.3.2",
    "rimraf": "5.0.7",
    "turbo": "2.0.6",
    "typescript": "5.5.3",
    "typescript-eslint": "7.15.0"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22"
  }
}
