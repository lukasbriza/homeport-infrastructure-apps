{
  "name": "@lukasbriza/nestjs",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "rimraf build tsconfig.build.tsbuildinfo",
    "build": "nest build",
    "cleanup": "rimraf .eslintcache .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo build node_modules --glob",
    "predev": "rimraf build tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "dev": "dotenv -v NODE_ENV=development -- nest start --watch",
    "fix": "run-p ts format:fix lint:fix",
    "format": "prettier --check --ignore-path .prettierignore \"./**/*.{graphql,json,md}\"",
    "format:fix": "pnpm run format --write",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "start": "NODE_ENV=production node build/main",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "ts": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@lukasbriza/eslint-config": "workspace:*",
    "@lukasbriza/ts-config": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.0",
    "dotenv-cli": "11.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
