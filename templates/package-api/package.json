{
  "name": "@lukasbriza/api",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "api-schema:generate": "pnpm openapi-typescript ./src/schema.json -o ./src/schema.ts",
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "tsc --build tsconfig.build.json",
    "cleanup": "rimraf .eslintcache .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage dist node_modules",
    "dev": "pnpm run build --watch",
    "fix": "run-p ts format:fix lint:fix",
    "format": "prettier --check \"./**/*.{json,md,mdx}\"",
    "format:fix": "pnpm run format --write",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "ts": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4"
  },
  "devDependencies": {
    "@lukasbriza/eslint-config": "workspace:*",
    "@lukasbriza/ts-config": "workspace:*",
    "@tanstack/react-query": "5.101.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "openapi-typescript": "7.13.0",
    "react": "19.2.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.101.2",
    "react": "19.2.7"
  }
}
